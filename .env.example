# CoursePilot 环境变量示例
# 复制本文件为 .env 并填入实际值

# ── 数据库 ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/coursepilot
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:password@localhost:5432/coursepilot

# ── LLM ────────────────────────────────────────────
LLM_API_KEY=sk-your-deepseek-key
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com

# ── JWT ────────────────────────────────────────────
JWT_SECRET_KEY=replace-with-a-random-secret-key-at-least-32-chars

# ── MCP ────────────────────────────────────────────
# MCP Server 启动模式：stdio / http
COURSEPILOT_MCP_TRANSPORT=stdio

# MCP Gateway 地址（stdio 桥接器使用）
COURSEPILOT_MCP_GATEWAY=https://mcp.coursepilot.example.com/mcp

# MCP API Key（MVP 阶段轻量认证）
COURSEPILOT_MCP_API_KEY=cp_your_api_key_here

# MCP 监听地址（HTTP/SSE 模式）
COURSEPILOT_MCP_HOST=0.0.0.0
COURSEPILOT_MCP_PORT=8080
